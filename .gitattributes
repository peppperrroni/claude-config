* text=auto

# setup.sh must check out with LF even on Windows: a CRLF shebang line makes
# bash fail with "$'\r': command not found".
*.sh  text eol=lf

# The git hook is a shell script with no extension, so *.sh does not reach it, and it is
# executed by Git for Windows' own sh on exactly the platform that would give it CRLF.
.githooks/post-merge text eol=lf

# PowerShell is happiest with CRLF on Windows and does not care elsewhere.
*.ps1 text eol=crlf

# Markdown is read by the model and by editors on every platform, and nothing
# here parses it with a CR-sensitive tool. Pinning LF keeps a Windows checkout
# byte-identical to a macOS one, so a diff never turns into a line-ending diff.
*.md  text eol=lf
